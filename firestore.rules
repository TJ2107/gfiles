rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Règle 1 : Collection des utilisateurs / Profils
    match /users/{userId} {
      allow read, write: if true;
    }

    // Règle 2 : Présence en temps réel
    match /presence/{userId} {
      allow read, write: if true;
    }

    // Règle 3 : Données SWO du projet
    match /projects/{projectId}/swo_data/{rowId} {
      allow read, write: if true;
    }

    // Règle 4 : Commentaires Manuels des sites
    match /projects/{projectId}/manual_comments/{commentId} {
      allow read, write: if true;
    }

    // Règle 5 : Affectations PM & Maintenance Préventive
    match /projects/{projectId}/pm_assignments/{assignmentId} {
      allow read, write: if true;
    }

    // Règle 6 : Données journalières
    match /projects/{projectId}/daily_raw_data/{dataId} {
      allow read, write: if true;
    }

    // Règle 7 : Configuration système
    match /config/{docId} {
      allow read, write: if true;
    }

    // Règle générale de secours
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

