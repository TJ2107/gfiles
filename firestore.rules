rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // Since Firebase Auth is disabled, we bypass it for development
    function isSignedIn() { return true; }
    function isSuperAdmin() { return true; }
    function hasRole(reqRole) { return true; }
    function isAdmin() { return true; }
    function isManager() { return true; }
    function isUser() { return true; }
    function isAuthOrAdmin() { return true; } 

    function isValidId(id) { return id is string && id.size() <= 128; }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /presence/{userId} {
      allow read, write: if true;
    }

    function isValidSwoData(data) {
      return data.project_id is string &&
             data.project_id.size() <= 64;
    }

    match /projects/{projectId}/swo_data/{rowId} {
      allow read, create, update, delete: if true;
    }
    
    function isValidComment(data) {
      return data.site_id is string && 
             data.category is string && 
             data.comment is string;
    }

    match /projects/{projectId}/manual_comments/{commentId} {
      allow read, create, update, delete: if true;
    }

    match /projects/{projectId}/pm_assignments/{assignmentId} {
      allow read, create, update, delete: if true;
    }

    match /projects/{projectId}/daily_raw_data/{dataId} {
      allow read, create, update, delete: if true;
    }

    match /config/{docId} {
      allow read, write: if true;
    }
  }
}
